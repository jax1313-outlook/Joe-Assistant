# ---- Never commit -------------------------------------------------------

# Live runtime state. This holds the DPAPI-encrypted Microsoft 365 token
# cache (runtime_data/auth/), and memory records carrying real driver
# requests and assistant responses. Level 1 records are built to expire in
# three hours; git history does not expire, so they do not belong in it.
Assistant_Plugin/runtime_data/
Assistant_Plugin/logs/

# ---- Build and scratch output -------------------------------------------

__pycache__/
*.pyc
*.pyo

# Recreated from nothing on every run.
Assistant_Plugin/proof/_workspace/
Assistant_Plugin/tests/_workspace/
ASST/*/Tests/_workspace/

# The BUILT package only - a duplicate of the plugin source, and keeping both
# copies in history is how they drift apart. Build it from source when a
# release is needed.
#
# The packaging scripts beside it are NOT ignored. They are source, and the
# earlier rule ignored the whole Deployment folder, so PACKAGE_ASSISTANT.cmd
# was untracked: it still excluded "assistant.config.json" long after the
# program was renamed to JOE, and nobody could see it in a diff.
Assistant_Plugin/Deployment/Assistant_Plugin_v1.0.0/

# ---- Separately versioned ------------------------------------------------

# Build/Jules is its own repository, with its own remote and branches.
# Tracking it from here would nest a repo inside a repo. Clone it separately:
#   https://github.com/jax1313-outlook/Jules.git
Build/Jules/

# Personal Claude Code overrides. Per-machine by design, and this repository
# is public - permission rules are nobody else's business.
.claude/settings.local.json
